=== test_closed_panic
--- main.n
import net.udp
import co
import runtime
import time

var count = 0

fn echo_server():void! {
    var buf = vec<u8>.new(0, 1024)
    var socket = udp.bind('0.0.0.0:8088')
    for true {
        var (len, addr) = socket.recvfrom(buf)
        socket.sendto(buf.slice(0, len), addr.to_string())
    }

    socket.close()
}

fn send():void! {
    var conn = udp.connect('127.0.0.1:8088')
    conn.write('hello world!!' as [u8])
    var buf = vec<u8>.new(0, 1024)

    var len = conn.read(buf)
    println('send success, recv msg', buf.slice(0, len) as string)
    conn.close()

    conn.read(buf) catch e {
        panic(describe_error(e))
        0
    }
}

fn main() {
    go echo_server()
    co.sleep(500) // wait server start

    var start = time.now().ms_timestamp()
    for int i = 0; i < 100; i += 1 {
        send()
    }
    var end = time.now().ms_timestamp()
    assert(end - start < 5000)
}


// Render diagnostics explicitly after catch; throw only carries enum values.
fn describe_error(errort e):string {
    if e == runtime_error_t.END_OF_FILE { return 'EOF' }
    if e == runtime_error_t.TIMEOUT { return 'tcp read timeout' }
    if e == runtime_error_t.CLOSED { return 'conn closed' }
    if e == runtime_error_t.INDEX_OUT_OF_RANGE { return 'index out of range' }
    if e == runtime_error_t.TYPE_MISMATCH { return 'type assert failed' }
    if e == runtime_error_t.NULL_POINTER { return 'invalid memory address or nil pointer dereference' }
    if e == runtime_error_t.KEY_NOT_FOUND { return 'key not found in map' }
    return 'operation failed'
}
--- output.txt
send success, recv msg hello world!!
panic: 'conn closed' at nature-test/main.n:29:30

=== test_dns[exclude_os=windows]
--- main.n
import co
import runtime
import net.dns


fn main() {
    var ips = dns.lookup('localhost')
    assert(ips.len() > 0)
    for ip in ips {
        assert(ip == '127.0.0.1' || ip == '::1')
    }
    println('localhost resolved')
}
--- output.txt
localhost resolved

=== test_dns_failed[exclude_os=windows]
--- main.n
import co
import runtime
import net.dns

fn main() {
    var caught = false
    var ips = dns.lookup('invalid host name') catch e {
        assert(e is system_error_t)
        assert((e as system_error_t).code != 0)
        caught = true
        []
    }
    assert(caught && ips.len() == 0)
    println('DNS error verified')
}
--- output.txt
DNS error verified

=== test_sendto_speed[exclude_os=windows]
--- main.n
import net.udp
import co
import runtime
import time

var count = 0

fn main() {
    var start = time.now().ms_timestamp()
    var conn = udp.connect('127.0.0.1:8088')
    var msg = 'hello\n' as [u8]

    for int i = 0; i < 100000; i += 1 {
        conn.write(msg)
    }

    conn.close()
    var end = time.now().ms_timestamp()
    println('use ms:', end - start)
    assert(end - start < 1000)
}
