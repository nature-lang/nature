=== test_panic
--- main.n
fn bar():void! {
    var list = vec<i8>.new(0, 10)
    var foo = list[11]
}

fn foo():void! {
    bar()
}

fn main():void! {
    foo() catch err {
        println('catch err:', err)
    }
}

--- output.txt
panic: 'index out of range [11] with length 10' at nature-test/main.n:3:21

=== test_catch_panic
