=== test_panic
--- main.n
fn bar():void! {
    var list = vec<i8>.new(0, 10)
    var foo = list[11]
}

fn foo():void! {
    bar()
}

fn main():void! {
    foo() catch err {
        println('catch err:', err)
    }
}

--- output.txt
panic: 'index out of range [11] with length 10' at nax-test/main.n:3:21

=== test_catch_panic
--- main.n
fn bar():void! {
    var list = vec<i8>.new(0, 10)
    var s = list[11] catch err {
        println('catch err:', err == INDEX_OUT_OF_RANGE)
        0
    }
}

fn foo():void! {
    bar()
}

fn main():void! {
    foo() catch err {
        println('catch err:', err)
    }
}

--- output.txt
catch err: true

=== test_errdef_msg
--- main.n
import io

errdef TIMEOUT 'request timed out'
errdef CLOSED

fn read(int mode):int! {
    if mode == 1 {
        throw TIMEOUT
    }
    throw CLOSED
}

fn main() {
    var a = read(1) catch e {
        println(e, e.msg())
        0
    }
    var b = read(2) catch e {
        println(e, e.msg())
        0
    }
    println(io.EOF.msg())
}

--- output.txt
main.TIMEOUT request timed out
main.CLOSED main.CLOSED
end of file
