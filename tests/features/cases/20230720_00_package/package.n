mod package

import rand
import rand.utils.seed
import syscall
import os
import local
import left
import right
import package.src.user

fn main() {
    user.dump()
    int r =  rand.dump()
    print('rand.dump() -> ', r, '\n')
    seed.dump()
    syscall.dump()
    os.dump()
    print('local.get_count() -> ', local.get_count(), '\n')
    local.dump()
    print('same-name deps: ', left.value(), '/', right.value(), '\n')
}
