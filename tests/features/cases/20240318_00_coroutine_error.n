import co

errset DIVISOR_ZERO
errset CLOSURE_ERROR

fn div(i32 dividend, i32 divisor):i32! {
    co.sleep(500)
    if (divisor == 0) {
        throw DIVISOR_ZERO
    }

    return dividend / divisor
}

fn main() {
    // 1.
    var fut = @async(fn():void! {
        println('in closure fn')
        co.sleep(1000)
        throw CLOSURE_ERROR
    }(), co.SAME)

    fut.await_void() catch err {
        println('fut.await catch err:', err)
    }

    // 2.
    var fut2 = go div(10, 0)
    var result = fut2.await() catch err {
        println('dive catch err:', err)
        10
    }
    println('div result', result)


    // 3.
    go div(10, 0)

    co.sleep(1000)
    println('main done')
}