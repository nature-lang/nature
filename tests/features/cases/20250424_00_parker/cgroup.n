import os
import fmt
import path
import parker.util
import syscall
import strings
import parker.log as *
import fs

type test_error_t:errort = enum {
    OPEN_PROCS_PATH_S_FAILED_S,
    PID_STR_S_TO_INT_FAILED,
    CGROUP_NEW_ERR,
    CANNOT_DETECT_CGROUP_VERSION,
}


u8 version1 = 1
u8 version2 = 2
const v1_default_system = 'freezer'
const procs_system = 'cgroup.procs'
const parker_dir = 'parker'

type cgroup_t = struct {
    string id
    u8 version
    string path
    string procs_path
}

fn cgroup_t.register(*self, int pid):void! {
    var pid_str = fmt.sprintf('%d\n', pid)

    logf("[cgroup_t.register] pid %d, procs_path %s", pid, self.procs_path)

    // fs open cannot open fd in mount ns
    // var f = fs.open(self.procs_path, syscall.O_WRONLY, 0)
    var fd = syscall.open(self.procs_path, syscall.O_WRONLY, 0)
    var f = fs.from(fd, self.procs_path)
    f.write(pid_str as [u8])

    f.close()
}

fn cgroup_t.clear(*self):void! {
    logf('s.procs_path is "%s"', self.procs_path)

    var f = fs.open(self.procs_path, syscall.O_RDONLY, 0) catch e {
        throw test_error_t.OPEN_PROCS_PATH_S_FAILED_S
    }

    var pids_str = f.content()
    if pids_str.len() == 0 {
        logf('no pids in cgroup=%s', self.procs_path)
    } else {
        logf('read pids from cgroup, %s', pids_str)
        var pids = pids_str.split('\n')

        for pid_str in pids {
            // str to int
            var pid = pid_str.to_int()
            if pid == 0 {
                throw test_error_t.PID_STR_S_TO_INT_FAILED
            }
            
            // kill by pid
            syscall.kill(pid, syscall.SIGKILL) catch e {
                logf('kill pid %d failed %s', pid, describe_error(e))
            }
        }
    }

    // 清理 cgroup 目录
    os.rmdir(self.path, true)
}

pub fn init():cgroup_t! {
    if !path.exists('/sys/fs/cgroup') {
        throw test_error_t.CGROUP_NEW_ERR
    }
    
    u8 version = 0
    
    if path.exists('/sys/fs/cgroup/cgroup.controllers') {
        version = version2
    }  else if path.exists(path.join("/sys/fs/cgroup", v1_default_system)) {
        version = version1
    } else {
        throw test_error_t.CANNOT_DETECT_CGROUP_VERSION
    }

    var id = util.rand_letter(32)
    
    var cgroup_path = ''
    if version == version1 {
        cgroup_path = path.join('/sys/fs/cgroup', v1_default_system, parker_dir, id)
    } else {
        cgroup_path = path.join('/sys/fs/cgroup', parker_dir, id)
    }

    var procs_path = path.join(cgroup_path, procs_system)

    // mkdir all
    os.mkdirs(cgroup_path, 0755)

    return cgroup_t{
        id: id,
        version: version,
        path: cgroup_path,
        procs_path: procs_path,
    }
}

// Render diagnostics explicitly after catch; throw only carries enum values.
fn describe_error(errort e):string {
    if e == test_error_t.OPEN_PROCS_PATH_S_FAILED_S { return 'open procs path="%s" failed: %s' }
    if e == test_error_t.PID_STR_S_TO_INT_FAILED { return 'pid str %s to int failed' }
    if e == test_error_t.CGROUP_NEW_ERR { return 'cgroup new err=' }
    if e == test_error_t.CANNOT_DETECT_CGROUP_VERSION { return 'cannot detect cgroup version' }
    if e == runtime_error_t.END_OF_FILE { return 'EOF' }
    if e == runtime_error_t.TIMEOUT { return 'tcp read timeout' }
    if e == runtime_error_t.CLOSED { return 'conn closed' }
    if e == strings.error_t.INVALID_DIGIT { return 'invalid character in number' }
    if e == strings.error_t.INVALID_NUMBER { return 'invalid number format' }
    if e == strings.error_t.OVERFLOW { return 'number too large' }
    if e == runtime_error_t.INDEX_OUT_OF_RANGE { return 'index out of range' }
    if e == runtime_error_t.TYPE_MISMATCH { return 'type assert failed' }
    if e == runtime_error_t.NULL_POINTER { return 'invalid memory address or nil pointer dereference' }
    if e == runtime_error_t.KEY_NOT_FOUND { return 'key not found in map' }
    return 'operation failed'
}
