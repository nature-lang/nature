=== test_basic
--- main.n
import net.tls

fn main() {
    var conn = tls.connect('34.160.111.145:443')
    var http_request = 'GET /ip HTTP/1.1\r\n' +
                       'Host: ifconfig.me\r\n' +
                       'User-Agent: nature-client/1.0' +
                       'Accept: application/json\r\n' +
                       'Connection: close\r\n' +
                       '\r\n'

    conn.write(http_request as [u8])
    var resp_buf = vec<u8>.new(0, 1024)
    int len = conn.read(resp_buf)
    conn.close()
    println(len, resp_buf.slice(0, len) as string)
    assert(len < 300 && len > 200)
}

=== test_timeout
--- main.n
import co
import net.tls
import net.tcp

fn main() {
    var conn = tls.connect_timeout('220.181.7.203:443', 30) catch e {
        println('in catch', describe_error(e))

        co.sleep(1000)
        return
    }
    println('connect success')
    co.sleep(1000)
}

// Render diagnostics explicitly after catch; throw only carries enum values.
fn describe_error(errort e):string {
    if e == runtime_error_t.END_OF_FILE { return 'EOF' }
    if e == runtime_error_t.TIMEOUT { return 'tcp read timeout' }
    if e == runtime_error_t.CLOSED { return 'conn closed' }
    if e == runtime_error_t.INDEX_OUT_OF_RANGE { return 'index out of range' }
    if e == runtime_error_t.TYPE_MISMATCH { return 'type assert failed' }
    if e == runtime_error_t.NULL_POINTER { return 'invalid memory address or nil pointer dereference' }
    if e == runtime_error_t.KEY_NOT_FOUND { return 'key not found in map' }
    return 'operation failed'
}
