=== test_future_result_abi
--- main.n
import co
type error_t:errort = enum { TIMEOUT }
fn fail():int! { co.sleep(20); throw error_t.TIMEOUT }
fn okay():int { return 42 }
fn empty() {}
fn failed_void():void! { throw error_t.TIMEOUT }
fn main() {
    var fu = @async(fail())
    co.sleep(100)
    var value = fu.await() catch e { println(e is error_t, e == error_t.TIMEOUT); -1 }
    var success = @async(okay())
    println(value,success.await())
    var nothing = @async(empty())
    nothing.await_void()
    var failure = @async(failed_void())
    failure.await_void() catch e { println(e == error_t.TIMEOUT) }
}
--- output.txt
true true
-1 42
true

