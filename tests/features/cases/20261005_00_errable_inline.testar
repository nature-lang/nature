=== test_concrete_error_to_union_n
--- main.n
type error_t:errort = enum { TIMEOUT }
type issue_t = int|string|errort
fn number():errable<int,int> { throw 7 }
fn text():errable<int,string> { throw 'propagated text' }
fn marked():int! { throw error_t.TIMEOUT }
fn outer(int kind):errable<int,issue_t> {
    if kind == 0 { return number() }
    if kind == 1 { return text() }
    return marked()
}
fn main() {
    try { outer(0) } catch e { println(e is int,e as int) }
    try { outer(1) } catch e { println(e is string,e as string) }
    try { outer(2) } catch e { var error = e as errort; println(error == error_t.TIMEOUT) }
}
--- output.txt
true 7
true propagated text
true

