=== test_native_errable_function_values
--- main.n
#linkid test_error_native_read
fn native(ptr<int> source,[u8] buffer):int!
fn invoke(fn(ptr<int>,[u8]):int! f, ptr<int> source, [u8] buffer):int! { return f(source, buffer) }
fn main() {
    int source = 65
    var buffer = [0 as u8]
    println(invoke(native, &source, buffer), buffer[0])
    var f = native
    println(invoke(f, &source, buffer))
    source = -1
    var ignored = invoke(native, &source, buffer) catch e { println(e == runtime_error_t.END_OF_FILE); -1 }
    ignored = f(&source, buffer) catch e { println(e == runtime_error_t.END_OF_FILE); -1 }
    source = 66
    println(f(&source, buffer), buffer[0])
}
--- output.txt
1 65
1
true
true
1 66

