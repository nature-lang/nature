=== test_scalars_n
--- main.n
type tiny_t:errort = u8
type signed_t:errort = i32
type fraction_t:errort = f64
type fraction32_t:errort = f32
type flag_t:errort = bool
fn leaf(int k):int! {
    if k == 1 { throw 255 as tiny_t }
    if k == 2 { throw -2147483648 as signed_t }
    if k == 3 { throw -123.125 as fraction_t }
    if k == 4 { throw 0.0625 as fraction32_t }
    if k == 5 { throw true as flag_t }
    return 42
}
fn middle(int k):int! { return leaf(k) }
fn outer(int k):int! { return middle(k) catch e { throw e } }
fn inspect(int k):int {
    return outer(k) catch e {
        if e is tiny_t { var x = e as tiny_t; println(x as u8) }
        if e is signed_t { var x = e as signed_t; println(x as i32) }
        if e is fraction_t { var x = e as fraction_t; println(x as f64) }
        if e is fraction32_t { var x = e as fraction32_t; println(x as f32) }
        if e is flag_t { var x = e as flag_t; println(x as bool) }
        return -k
    }
}
fn main() {
    for int i = 0; i < 6; i += 1 {
        println(inspect(i))
    }
}

--- output.txt
42
255
-1
-2147483648
-2
-123.125000
-3
0.062500
-4
true
-5

