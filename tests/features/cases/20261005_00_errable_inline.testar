=== test_concrete_error_n
--- main.n
type large_t = struct { int a; int b; int c; int d }
fn number():errable<int,int> { throw 0 }
fn text():errable<int,string> { throw 'typed text' }
fn large():errable<int,large_t> { throw large_t{a:1,b:2,c:3,d:4} }
fn propagate():errable<int,large_t> { return large() }
fn constructor(bool bad):errable<int,int> {
    if bad { return errable<int,int>.error(17) }
    return errable<int,int>.value(42)
}
fn main() {
    var a = number() catch e { println(e); -1 }
    var b = text() catch e { println(e); -2 }
    var c = propagate() catch e { println(e.a,e.b,e.c,e.d); -3 }
    var d = constructor(true) catch e { println(e); -4 }
    var success = constructor(false) catch e { -99 }
    println(a,b,c,d,success)
    var result = errable<int,string>.error('manual result')
    if result is errable.error e { println(e) }
}
--- output.txt
0
typed text
1 2 3 4
17
-1 -2 -3 -4 42
manual result

=== test_no_error_allocation_n
--- main.n
#linkid runtime_malloc_bytes
fn allocated():u64
type error_t:errort = enum { FIRST, SECOND }
fn leaf(int k):int! {
    if k % 2 == 0 { throw error_t.FIRST }
    throw error_t.SECOND
}
fn middle(int k):int! { return leaf(k) }
fn outer(int k):int! { return middle(k) catch e { throw e } }
fn main() {
    var before = allocated()
    int sum = 0
    for int i = 0; i < 10000; i += 1 {
        sum += outer(i) catch e { e == error_t.FIRST ? 1 : 2 }
    }
    var bytes = allocated() - before
    println(sum,bytes)
}
