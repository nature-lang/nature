=== test_small_struct_n
--- main.n
type pair_t:errort = struct { i64 count; f64 scale }
type triple_t:errort = struct { i64 a; i64 b; i64 c }
fn leaf(int k):int! {
    if k == 1 { var p = pair_t{count: -9000000000, scale: 0.125}; throw p }
    throw triple_t{a: 0, b: -42, c: 123456789}
}
fn outer(int k):int! { return leaf(k) catch e { throw e } }
fn grab(int k):errort {
    errort saved = triple_t{a: 0, b: 0, c: 0}
    var ignored = outer(k) catch e { saved = e; 0 }
    return saved
}
fn main() {
    var p = grab(1) as pair_t
    var q = grab(2) as triple_t
    println(p.count, p.scale, q.a, q.b, q.c)
}
--- output.txt
-9000000000 0.125000 0 -42 123456789

