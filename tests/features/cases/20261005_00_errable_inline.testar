=== test_error_storage_roundtrip_n
--- main.n
type error_t:errort = enum:u8 { TIMEOUT }
type issue_t = errort|int
fn number():errable<int,int> { throw 7 }
fn main() {
    errort original = error_t.TIMEOUT
    any boxed = original
    var restored = boxed as errort
    println(boxed is errort, restored == error_t.TIMEOUT)
    issue_t union_value = original
    var unwrapped = union_value as errort
    println(union_value is errort, unwrapped == error_t.TIMEOUT)
    var raw = original as anyptr
    var address = raw as ptr<errort>
    println(*address == error_t.TIMEOUT)
    any scalar = 42
    println(scalar as int)
    var ignored = scalar as errort catch e {
        println(e == runtime_error_t.TYPE_MISMATCH)
        original
    }
    try { var pointer = original as anyptr; number() } catch code { println(code) }
}
--- output.txt
true true
true true
true
42
true
7

