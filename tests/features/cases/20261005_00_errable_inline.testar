--- main.n
type io_error_t:errort = enum { NET_TIMEOUT, CONNECTION_CLOSED }
type string_error_t:errort = enum { LENGTH_LIMIT }
fn leaf(int k):int! {
    if k == 1 { throw io_error_t.NET_TIMEOUT }
    if k == 2 { throw string_error_t.LENGTH_LIMIT }
    return 42
}
fn middle(int k):int! { return leaf(k) }
fn rethrow(int k):int! { return middle(k) catch e { throw e } }
fn decode(int k):int {
    return rethrow(k) catch e {
        println(e is io_error_t, e is string_error_t, e == io_error_t.NET_TIMEOUT, string_error_t.LENGTH_LIMIT == e)
        if e is io_error_t { var v = e as io_error_t; println(v == io_error_t.NET_TIMEOUT) }
        return -1
    }
}
fn main() { println(decode(0), decode(1), decode(2)) }
