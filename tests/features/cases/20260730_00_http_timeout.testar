=== test_stream_read_timeout
--- main.n
import http.client
import net.tcp
import co

fn serve():void! {
    var server = tcp.listen('127.0.0.1:18992')
    var conn = server.accept()
    var request = vec<u8>.new(0, 4096)
    conn.read(request)
    conn.write(('HTTP/1.1 200 OK\r\n' +
                'Content-Length: 5\r\n' +
                'Content-Type: text/plain\r\n' +
                '\r\n') as [u8])
    co.sleep(200)
    conn.close()
    server.close()
}

fn main() {
    go serve()
    co.sleep(100)
    var resp = client.new().timeout(50).get('http://127.0.0.1:18992/slow').send()
    var scratch = vec<u8>.new(0, 16)
    bool timed_out = false
    resp.read(scratch) catch e {
        timed_out = e == client.error_t.READ_TIMEOUT
        0
    }
    resp.close()
    assert(timed_out)
}

=== test_response_header_timeout
--- main.n
import http.client
import net.tcp
import co

fn serve():void! {
    var server = tcp.listen('127.0.0.1:18993')
    var conn = server.accept()
    var request = vec<u8>.new(0, 4096)
    conn.read(request)
    co.sleep(200)
    conn.close()
    server.close()
}

fn request_head():void! {
    var response = client.new().timeout(50).get('http://127.0.0.1:18993/slow').send()
    response.close()
}

fn main() {
    go serve()
    co.sleep(100)
    bool timed_out = false
    request_head() catch e {
        timed_out = e == client.error_t.READ_TIMEOUT
    }
    assert(timed_out)
}

=== test_cross_coroutine_close_pending_read
--- main.n
import net.tcp
import co

type read_state_t = struct{
    bool started
    bool done
    string error
}

fn serve():void! {
    var server = tcp.listen('127.0.0.1:18994')
    var conn = server.accept()
    co.sleep(200)
    conn.close()
    server.close()
}

fn read_pending(ref<tcp.conn_t> conn, ref<read_state_t> state) {
    state.started = true
    var scratch = vec<u8>.new(0, 16)
    conn.read(scratch) catch e {
        state.error = describe_error(e)
        0
    }
    state.done = true
}

fn main() {
    go serve()
    co.sleep(100)
    var conn = tcp.connect('127.0.0.1:18994')
    var state = new read_state_t()
    go read_pending(conn, state)
    for !state.started {
        co.sleep(1)
    }
    conn.close()
    for !state.done {
        co.sleep(1)
    }
    assert(state.error == 'conn closed')
}

// Render diagnostics explicitly after catch; throw only carries enum values.
fn describe_error(errort e):string {
    if e == runtime_error_t.END_OF_FILE { return 'EOF' }
    if e == runtime_error_t.TIMEOUT { return 'tcp read timeout' }
    if e == runtime_error_t.CLOSED { return 'conn closed' }
    if e == runtime_error_t.INDEX_OUT_OF_RANGE { return 'index out of range' }
    if e == runtime_error_t.TYPE_MISMATCH { return 'type assert failed' }
    if e == runtime_error_t.NULL_POINTER { return 'invalid memory address or nil pointer dereference' }
    if e == runtime_error_t.KEY_NOT_FOUND { return 'key not found in map' }
    return 'operation failed'
}
