type sub_t = struct {
    i32 a
    i64 b
}

pub type person_t = struct {
    [i32;8] foo
    bool bar
    sub_t car
    struct {
        f64 a
        f64 b
    } dog
    [f32] egg
}

fn test_array([int;5] a):[int;5] {
    a[0] = 1111
    a[2] = 3333

    return a
}

fn main() {
    // basic
    [int;5] a1 = []
    a1[0] = 11
    a1[1] = 12

    println(a1[0], a1[1])

    var b = a1[0]
    var b1 = a1[5] catch err {
        println(describe_error(err))
        0
    }
    println(b, b1, a1[0])

    // array copy
    [int;5] bar = a1
    bar[0] = 100
    println(bar[0], bar[1], bar[2], a1[0])

    // array param
    var car = test_array(a1)
    println(a1[0], car[0], car[2])

    // list nest array
    [[i64;3]] a3 = []

    a3.push([1, 2, 3])
    a3.push([11, 12, 13])

    // access
    println(a3[0][0], a3[0][1], a3[0][2], a3[1][0], a3[1][1], a3[1][2])

    var r1 = a3[0][5] catch err {
        println(describe_error(err))
        0
    }

    // array in struct
    // 0 0 0.000000 0 0 false
    // 789 987 3.141500 456 1 true


    var p = person_t{}
    println(p.foo[0], p.foo[7], p.dog.a, p.car.a, p.egg.len(), p.bar)

    // assign
    p.egg.push(3.1415)
    p.dog.a = 3.1415
    p.car.b = 456
    p.foo[0] = 789
    p.foo[7] = 987
    p.bar = true
    println(p.foo[0], p.foo[7], p.dog.a, p.car.b, p.egg.len(), p.bar)
}
// Render diagnostics explicitly after catch; throw only carries enum values.
fn describe_error(errort e):string {
    if e == runtime_error_t.END_OF_FILE { return 'EOF' }
    if e == runtime_error_t.TIMEOUT { return 'tcp read timeout' }
    if e == runtime_error_t.CLOSED { return 'conn closed' }
    if e == runtime_error_t.INDEX_OUT_OF_RANGE { return 'index out of range' }
    if e == runtime_error_t.TYPE_MISMATCH { return 'type assert failed' }
    if e == runtime_error_t.NULL_POINTER { return 'invalid memory address or nil pointer dereference' }
    if e == runtime_error_t.KEY_NOT_FOUND { return 'key not found in map' }
    return 'operation failed'
}
