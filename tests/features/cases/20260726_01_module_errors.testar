// Every case shares one file set (package.toml/main.n/mods/a.n/mods/b.n) and rewrites all of them,
// otherwise a bad mod declaration left by a previous case would affect later cases during the package scan.
// Cases needing extra files (mods/c*.n, mods.n) are all placed last.

=== test_mod_name_mismatch_subdir
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
fn main() {
}

--- mods/a.n
mod wrong

fn a() {}

--- mods/b.n
fn b() {}

--- output.txt
nature-test/mods/a.n:1:1: 'mod wrong' does not match directory 'mods', use 'mod mods'

=== test_mod_name_mismatch_root
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
mod wrong

fn main() {
}

--- mods/a.n
fn a() {}

--- mods/b.n
fn b() {}

--- output.txt
nature-test/main.n:1:1: 'mod wrong' does not match package name 'modtest', use 'mod modtest'

