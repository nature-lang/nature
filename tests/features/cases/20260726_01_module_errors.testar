=== test_pre_infer_error_path_points_at_declaring_part
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
import modtest.mods

fn main() {
}

--- mods/a.n
mod mods

type node3_t = node_t
type node2_t = node3_t
type node_t = node2_t

fn broken(node_t value) {
}

--- mods/mods.n
mod mods

fn later():int {
    return 2
}

--- output.txt
nature-test/mods/a.n:7:2: recycle use type 'modtest.mods.node_t'

=== test_target_variant_membership_mismatch
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
fn main() {
}

--- mods/a.n
fn a() {}

--- mods/mods.n
mod mods

fn b() {}

--- mods/c.n
fn c() {}

--- mods/c.darwin.n
mod mods

fn c() {}

--- mods/c.linux.n
mod mods

fn c() {}

--- mods/c.windows.n
mod mods

fn c() {}

--- output.txt
nature-test/mods/c.n:1:1: target variants of 'c' must belong to the same module, but nature-test/mods/c.darwin.n declares 'mod mods' and nature-test/mods/c.n declares no mod

=== test_file_and_directory_module_collision
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
import modtest.mods

fn main() {
}

--- mods.n
fn boom() {}

--- mods/a.n
mod mods

fn a() {}

--- mods/mods.n
mod mods

fn b() {}

--- mods/c.n
fn c() {}

--- mods/c.darwin.n
fn c_darwin() {}

--- mods/c.linux.n
fn c_linux() {}

--- mods/c.windows.n
fn c_windows() {}

--- output.txt
nature-test/mods/a.n:1:1: module modtest.mods is defined by two layouts: nature-test/mods.n (standalone file module) and nature-test/mods/a.n (part of directory module)

