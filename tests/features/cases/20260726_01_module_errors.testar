=== test_cross_part_redeclare
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
import modtest.mods

fn main() {
    println(mods.dup())
}

--- mods/a.n
mod mods

fn dup():int {
    return 1
}

--- mods/b.n
mod mods

fn dup():int {
    return 2
}

--- output.txt
nature-test/mods/b.n:3:2: ident 'modtest.mods.dup' redeclared

=== test_mod_not_at_head
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
import modtest.mods.a

fn main() {
    println(a.a())
}

--- mods/a.n
import fmt
mod mods

fn a():string {
    return fmt.sprintf('a')
}

--- mods/b.n
fn b() {}

--- output.txt
nature-test/mods/a.n:2:3: 'mod' declaration must be the first statement of the file

=== test_error_path_points_at_declaring_part
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
import modtest.mods

fn main() {
    println(mods.broken())
}

--- mods/a.n
mod mods

fn broken():int {
    string s = 'x'
    return s
}

--- mods/b.n
mod mods

fn b():int {
    return 2
}

--- output.txt
nature-test/mods/a.n:5:12: type inconsistency, expect=int(i64), actual=string

=== test_target_variant_membership_mismatch
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
fn main() {
}

--- mods/a.n
fn a() {}

--- mods/b.n
fn b() {}

--- mods/c.n
fn c() {}

--- mods/c.darwin.n
mod mods

fn c() {}

--- mods/c.linux.n
mod mods

fn c() {}

--- mods/c.windows.n
mod mods

fn c() {}

--- output.txt
nature-test/mods/c.n:1:1: target variants of 'c' must belong to the same module, but nature-test/mods/c.darwin.n declares 'mod mods' and nature-test/mods/c.n declares no mod

=== test_package_entry_field_rejected
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"
entry = "main"

--- main.n
fn main() {
}

--- mods/a.n
fn a() {}

--- mods/b.n
fn b() {}

--- mods/c.n
fn c() {}

--- mods/c.darwin.n
fn c_darwin() {}

--- mods/c.linux.n
fn c_linux() {}

--- mods/c.windows.n
fn c_windows() {}

--- output.txt
nature-test/package.toml:1:1: package.toml field 'entry' is not supported, remove it and pass the source path to 'nature build'

=== test_file_and_directory_module_collision
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
import modtest.mods

fn main() {
}

--- mods.n
fn boom() {}

--- mods/a.n
mod mods

fn a() {}

--- mods/b.n
mod mods

fn b() {}

--- mods/c.n
fn c() {}

--- mods/c.darwin.n
fn c_darwin() {}

--- mods/c.linux.n
fn c_linux() {}

--- mods/c.windows.n
fn c_windows() {}

--- output.txt
nature-test/mods/a.n:1:1: module modtest.mods is defined by two layouts: nature-test/mods.n (standalone file module) and nature-test/mods/a.n (part of directory module)
