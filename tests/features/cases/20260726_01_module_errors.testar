=== test_error_path_points_at_declaring_part
--- package.toml
name = "modtest"
version = "1.0.0"
type = "bin"

--- main.n
import modtest.mods

fn main() {
    println(mods.broken())
}

--- mods/a.n
mod mods

pub fn broken():int {
    string s = 'x'
    return s
}

--- mods/mods.n
mod mods

fn b():int {
    return 2
}

--- output.txt
nature-test/mods/a.n:5:12: type inconsistency, expect=int(i64), actual=string

