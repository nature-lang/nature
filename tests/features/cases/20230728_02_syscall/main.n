import syscall

fn main():void! {
    string path = './asserts/test_mkdir'
    string path2 = './asserts/test_rename'

    syscall.mkdir(path, 0755) catch err {
        print('mkdir err: ', describe_error(err), '\n')
    }

    // 读取目录进行检查
    var st = syscall.stat(path)
    print('mkdir directory: ', syscall.stat_is_dir(st.mode), '\n')

    // 修改目录名称 test_rename
    syscall.rename(path, path2)
    println('rename success')

    var st2 = syscall.stat(path2)
    print('rename directory: ', syscall.stat_is_dir(st2.mode), '\n')

    // chmod 为 0744
    syscall.chmod(path2, 0744)

    st2 = syscall.stat(path2)
    print('chmod directory: ', syscall.stat_is_dir(st2.mode), '\n')

    // rmdir
    syscall.rmdir(path2)
    println('rmdir success')
    var _ = syscall.stat(path2) catch err {
        println('missing stat failed')
        syscall.stat_t{}
    }

    var pid = syscall.getpid()
    if pid > 0 {
        println('getpid success')
    }

    var ppid = syscall.getppid()
    if ppid > 0 {
        println('getppid success')
    }

    // get cwd
    var cwd = syscall.getcwd()
    if cwd.len() > 0 {
        println('getcwd success')
    }
}

// Render diagnostics explicitly after catch; throw only carries enum values.
fn describe_error(errort e):string {
    if e == runtime_error_t.END_OF_FILE { return 'EOF' }
    if e == runtime_error_t.TIMEOUT { return 'tcp read timeout' }
    if e == runtime_error_t.CLOSED { return 'conn closed' }
    if e == runtime_error_t.INDEX_OUT_OF_RANGE { return 'index out of range' }
    if e == runtime_error_t.TYPE_MISMATCH { return 'type assert failed' }
    if e == runtime_error_t.NULL_POINTER { return 'invalid memory address or nil pointer dereference' }
    if e == runtime_error_t.KEY_NOT_FOUND { return 'key not found in map' }
    return 'operation failed'
}
