=== test_resolve_data_flow_change_to_temp_in
--- main.n
fn test1(int a) {
    println(a)
}

fn main():void! {
    int kv_dim = 244 // head 分配
    int dim = 12

    for int i = 0; i < dim; i += 2 {
        int rotn = 1
        if i < kv_dim {
            rotn = 2
        }

        for int v = 0; v < rotn; v+=1 {
           test1(1)
        }
    }

    test1(kv_dim)

    go fn() {
        int a = kv_dim
    }()
}

