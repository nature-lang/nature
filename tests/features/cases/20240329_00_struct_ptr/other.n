pub type person_t = struct{
    string name
    int age
    bool sex
}


pub fn person_t.set_age(*self, int now) {
    self.age = now
}

pub fn person_t.get_name(*self):string {
    return self.name
}

pub fn person_t.test_self(self) {
    person_t p = self
    println('in test_self', p.name, p.age, p.sex)
}
