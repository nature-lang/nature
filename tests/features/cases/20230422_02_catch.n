errdef HELLO_ERROR
errdef WORLD_ERROR
errdef WRAPPED_ERROR

fn hello():void! {
    println('hello nax')
    throw HELLO_ERROR
}

fn main():void! {
    hello() catch err {
        println('catch err:', err)
    }

    // closure fn
    var world = fn(bool e):int! {
        if e {
            throw WORLD_ERROR
        }
        return 233
    }

    int foo = world(true) catch err {
        println('catch err:', err)
        12
    }
    println('foo =', foo)

    foo = world(false) catch err {
        println('catch err:', err)
        12
    }
    println('foo =', foo)


    // return
    hello() catch err1 {
        throw WRAPPED_ERROR
    }
}
