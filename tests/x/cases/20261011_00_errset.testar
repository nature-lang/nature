=== test_import_forms_and_forward_reference
--- main.x
import "io.x".{TIMEOUT}
import "fmt.x" as f

fn selective():int! { throw TIMEOUT }
fn aliased():int! { throw f.TIMEOUT }
fn forward():int! { throw LATE }

errset LATE

fn main() {
    println(selective() catch e { println(e == TIMEOUT, e == f.TIMEOUT, e == LATE); -1 })
    println(aliased() catch e { println(e == TIMEOUT, e == f.TIMEOUT, e == LATE); -2 })
    println(forward() catch e { println(e == TIMEOUT, e == f.TIMEOUT, e == LATE); -3 })
}
--- io.x
