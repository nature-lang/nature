=== test_errset
--- main.x
errdef TIMEOUT
errdef CLOSED
errdef LATE

fn read(int mode):int! {
    if mode == 1 {
        throw TIMEOUT
    }
    if mode == 2 {
        throw CLOSED
    }
    return 42
}

fn relay(int mode):int! {
    return read(mode)
}

fn rethrow(int mode):int! {
    var v = read(mode) catch e {
        throw e
    }
    return v
}

fn add(int a, int b):int! {
    return a + b
}

fn sum(int mode):int! {
    var total = add(read(mode), 1) catch e {
        -100
    }
    return total
}

fn is_timeout(errset_t e):bool {
    return e == TIMEOUT
}

fn nothing(bool fail)! {
    if fail {
        throw CLOSED
    }
}

fn pass<T>(T value, bool fail):T! {
    if fail {
        throw TIMEOUT
    }
    return value
}

type reader_t = interface{
    fn get(int mode):int!
}

type source_t:reader_t = int

fn source_t.get(self, int mode):int! {
    return read(mode)
}

fn fail_late()! {
    throw LATE
}

fn cleanup(bool failure):int! {
    defer {
        fail_late()
    }
    if failure {
        throw TIMEOUT
    }
    return 1
}

type shape = union{
    int circle
    (int, int) rectangle
}

fn make(bool fail):shape! {
    if fail {
        throw CLOSED
    }
    return shape.rectangle(1, 2)
}

fn main() {
    var a = read(0) catch e {
        -1
    }
    println(a)

    var b = read(1) catch e {
        println(e == TIMEOUT, e != CLOSED, is_timeout(e))
        -2
    }
    println(b)

    var saved = CLOSED
    var c = relay(1) catch e {
        saved = e
        -3
    }
    println(c, saved == TIMEOUT)

    var d = rethrow(2) catch e {
        println('rethrow', e == CLOSED)
        -4
    }
    println(d)

    var f = sum(2) catch e {
        println('argument', e == CLOSED)
        -5
    }
    println(f)

    var g = read(1) catch first {
        var inner = read(2) catch second {
            println('nested', first == TIMEOUT, second == CLOSED)
            -6
        }
        inner
    }
    println(g)

    var h = read(2) catch e {
        match e {
            TIMEOUT -> -7
            CLOSED -> -8
            _ -> -9
        }
    }
    println(h)

    nothing(true) catch e {
        println('void!', e == CLOSED)
    }

    var i = pass<int>(9, false) catch e {
        -1
    }
    var j = pass<string>('s', true) catch e {
        'generic'
    }
    println(i, j)

    source_t source = 0
    reader_t reader = source
    var k = reader.get(1) catch e {
        println('interface', e == TIMEOUT)
        -10
    }
    println(k)

    var l = cleanup(true) catch e {
        println('defer', e == TIMEOUT, e == LATE)
        -11
    }
    println(l)

    var m = cleanup(false) catch e {
        println('defer only', e == LATE)
        -12
    }
    println(m)

    var n = make(true) catch e {
        shape.circle(-1)
    }
    if n is shape.circle v {
        println('circle', v)
    }
}
--- output.txt
42
true true true
-2
-3 true
rethrow true
-4
argument true
-5
nested true true
-6
-8
void! true
9 generic
interface true
-10
defer true false
-11
defer only true
-12
circle -1

=== test_same_name_in_two_modules_is_two_errors
--- main.x
import "io.x"
import "fmt.x" as f
import "lib.n".{TIMEOUT}

fn outer(int mode):int! {
    return io.read(mode)
}

fn from_n()! {
    throw TIMEOUT
}

fn forward()! {
    throw LATE
}

errdef LATE

fn main() {
    var a = io.read(1) catch e {
        println(e == io.TIMEOUT, e == f.TIMEOUT, e == TIMEOUT)
        -1
    }
    println(a)

    var b = f.read(1) catch e {
        println(e == io.TIMEOUT, e == f.TIMEOUT, e == TIMEOUT)
        -2
    }
    println(b)

    var c = outer(1) catch e {
        println('propagated', e == io.TIMEOUT)
        -3
    }
    println(c)

    var d = outer(0) catch e {
        -4
    }
    println(d)

    from_n() catch e {
        println(e == io.TIMEOUT, e == f.TIMEOUT, e == TIMEOUT, e == LATE)
    }
    forward() catch e {
        println(e == TIMEOUT, e == LATE)
    }
}
--- io.x
errdef TIMEOUT

pub fn read(int mode):int! {
    if mode == 1 {
        throw TIMEOUT
    }
    return 7
}
--- fmt.x
errdef TIMEOUT

pub fn read(int mode):int! {
    if mode == 1 {
        throw TIMEOUT
    }
    return 8
}
--- lib.n
errdef TIMEOUT
--- output.txt
true false false
-1
false true false
-2
propagated true
-3
7
false false true false
false true

=== test_panic_errsets
--- main.x
type reader_t = interface{
    fn read():int
}

type file_t:reader_t = struct{
    int fd
}

fn file_t.read(self):int {
    return self.fd
}

type sock_t:reader_t = struct{
    int port
}

fn sock_t.read(self):int {
    return self.port
}

fn main() {
    [int;3] list = [1, 2, 3]
    int i = 5
    var a = list[i] catch e {
        println('index', e == INDEX_OUT_OF_RANGE)
        -1
    }
    println(a)

    reader_t r = file_t{fd: 3}
    var s = r as sock_t catch e {
        println('as', e == TYPE_ASSERT_FAILED)
        sock_t{port: 0}
    }
    println(s.port)

    var b = list[list[i]] catch e {
        0
    }
    println(b)
}
--- output.txt
index true
-1
as true
0
panic: 'index out of range [5] with length 3' at nature-test/main.x:37:23

=== test_tuple_operand_panic_is_not_caught
