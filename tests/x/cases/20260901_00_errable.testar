=== test_propagate
--- main.x
// declare, call, propagate, catch with nothing thrown
fn risky(int v):int! {
    return v * 2
}

fn caller(int v):int! {
    return risky(v)
}

fn main() {
    var a = caller(21) catch e {
        -1
    }
    println('happy:', a)
}

--- output.txt
happy: 42

=== test_throw_catch
--- main.x

type test_error_t:errort = enum {
    NEGATIVE_INPUT,
}

fn risky(int v):int! {
    if v < 0 {
        throw test_error_t.NEGATIVE_INPUT
    }
    return v * 2
}

fn main() {
    var b = risky(-1) catch e {
        println('caught:', describe_error(e))
        -2
    }
    println('thrown:', b)
}


fn describe_error(errort e):string {
    if e == test_error_t.NEGATIVE_INPUT { return 'negative input' }
    return 'operation failed'
}
--- output.txt
caught: negative input
thrown: -2

=== test_same_catch_site_twice
--- main.x

type test_error_t:errort = enum {
    FIRST,
    SECOND,
}

// One catch site must preserve the error value from each execution.
fn fail(bool first):string! {
    if first {
        throw test_error_t.FIRST
    }
    throw test_error_t.SECOND
}

fn grab(bool first):string {
    var s = fail(first) catch e {
        return describe_error(e)
    }
    return 'none'
}

fn main() {
    println(grab(true), grab(false))
}


fn describe_error(errort e):string {
    if e == test_error_t.FIRST { return 'FIRST' }
    if e == test_error_t.SECOND { return 'SECOND' }
    return 'operation failed'
}
--- output.txt
FIRST SECOND

=== test_error_escapes_catching_fn
--- main.x

type test_error_t:errort = enum {
    ESCAPED,
}

// An error value can outlive the frame that caught it.
fn fail():string! {
    throw test_error_t.ESCAPED
}

fn escape():errort {
    errort saved = runtime_error_t.FAILED
    fail() catch e { saved = e; '' }
    return saved
}

fn main() {
    println('escape:', describe_error(escape()))
}


fn describe_error(errort e):string {
    if e == test_error_t.ESCAPED { return 'ESCAPED' }
    return 'operation failed'
}
--- output.txt
escape: ESCAPED

=== test_catch_in_loop
--- main.x

type test_error_t:errort = enum {
    ODD,
    EVEN,
}

// Each iteration must receive its own error value.
fn fail(bool odd):string! {
    if odd {
        throw test_error_t.ODD
    }
    throw test_error_t.EVEN
}

fn main() {
    for int i = 0; i < 3; i += 1 {
        var s = fail(i == 1) catch e {
            describe_error(e)
        }
        println(i, s)
    }
}


fn describe_error(errort e):string {
    if e == test_error_t.ODD { return 'ODD' }
    if e == test_error_t.EVEN { return 'EVEN' }
    return 'operation failed'
}
--- output.txt
0 EVEN
1 ODD
2 EVEN

=== test_nested_catch
--- main.x

type test_error_t:errort = enum {
    AAA,
    BBB,
}

// A nested handler must preserve the outer error value.
fn fail_a():int! {
    throw test_error_t.AAA
}

fn fail_b():int! {
    throw test_error_t.BBB
}

fn main() {
    fail_a() catch e {
        fail_b() catch e2 {
            0
        }
        println('error =', describe_error(e))
        0
    }
}


fn describe_error(errort e):string {
    if e == test_error_t.AAA { return 'AAA' }
    if e == test_error_t.BBB { return 'BBB' }
    return 'operation failed'
}
--- output.txt
error = AAA

