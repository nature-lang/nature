=== test_catch_builtin
--- main.x
import allocator as ac

// A caught bounds check carries runtime_error_t.INDEX_OUT_OF_RANGE.
fn main() {
    var v = vec<int>.alloc(ac.heap, 0, 2)
    defer v.deinit()

    var x = v[5] catch e {
        println('builtin caught:', describe_error(e))
        -1
    }
    println(x)
}


fn describe_error(errort e):string {
    if e == runtime_error_t.INDEX_OUT_OF_RANGE { return 'index out of range' }
    return 'operation failed'
}
--- output.txt
builtin caught: index out of range
-1

