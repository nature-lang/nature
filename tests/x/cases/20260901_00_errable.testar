    return 'operation failed'
}
--- worker.x

pub type test_error_t:errort = enum {
    LARGE_X_FAILURE,
}

pub type pair_t = struct {
    int left
    int right
}

pub fn make_pair(bool fail):pair_t! {
    if fail {
        throw test_error_t.LARGE_X_FAILURE
    }
    return pair_t{left: 40, right: 2}
}

--- output.txt
n ok: 40 2
n caught: large x failure
n fallback: 3 4

