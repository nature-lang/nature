=== test_void_errable_variants
--- main.x

type test_error_t:errort = enum {
    VOID_FAILED,
}

fn action(bool fail):void! {
    if fail {
        throw test_error_t.VOID_FAILED
    }
}

fn main() {
    action(false) catch e {
        println('unexpected:', describe_error(e))
    }
    println('void value')

    action(true) catch e {
        println('void error:', describe_error(e))
    }
}


fn describe_error(errort e):string {
    if e == test_error_t.VOID_FAILED { return 'void failed' }
    return 'operation failed'
}
