=== test_defer_with_errable_call
--- main.x

type test_error_t:errort = enum {
    BOOM,
}

// defer bodies run while the error is propagating; an errable call inside one must not
// disturb the error in flight
fn cleanup():int! {
    return 1
}

fn work():int! {
    defer {
        cleanup()
    }
    throw test_error_t.BOOM
}

fn main() {
    var v = work() catch e {
        println('caught:', describe_error(e))
        -1
    }
    println(v)
}


fn describe_error(errort e):string {
    if e == test_error_t.BOOM { return 'boom' }
    return 'operation failed'
}
--- output.txt
caught: boom
-1

=== test_defer_error_preserves_original
--- main.x

type test_error_t:errort = enum {
    CLEANUP_FAILED,
    ORIGINAL_FAILURE,
}

// If cleanup fails while another error is already unwinding, the original error wins.
// The error slot is also the propagation state, so overwriting it would lose the cause.
fn cleanup():int! {
    throw test_error_t.CLEANUP_FAILED
}

fn work():int! {
    defer {
        cleanup()
    }
    throw test_error_t.ORIGINAL_FAILURE
}

fn main() {
    var v = work() catch e {
        println('caught:', describe_error(e))
        -1
    }
    println(v)
}


fn describe_error(errort e):string {
    if e == test_error_t.CLEANUP_FAILED { return 'cleanup failed' }
    if e == test_error_t.ORIGINAL_FAILURE { return 'original failure' }
    return 'operation failed'
}
--- output.txt
caught: original failure
-1

=== test_defer_can_raise_first_error
--- main.x

type test_error_t:errort = enum {
    CLEANUP_IS_FIRST,
}

// The conditional store must still accept a defer's error when normal return did
// not already place one in the function result.
fn cleanup():int! {
    throw test_error_t.CLEANUP_IS_FIRST
}

fn work():int! {
    defer {
        cleanup()
    }
    return 42
}

fn main() {
    var v = work() catch e {
        println('caught:', describe_error(e))
        -1
    }
    println(v)
}


fn describe_error(errort e):string {
    if e == test_error_t.CLEANUP_IS_FIRST { return 'cleanup is first' }
    return 'operation failed'
}
--- output.txt
caught: cleanup is first
-1

=== test_large_value_result
--- main.x

type test_error_t:errort = enum {
    PAIR_FAILED,
}

// errort is 32 bytes, so tagged errable<pair_t,errort> is 40 bytes and uses
// the platform's indirect aggregate-return ABI.
type pair_t = struct {
    int left
    int right
}

fn make_pair(bool fail):pair_t! {
    if fail {
        throw test_error_t.PAIR_FAILED
    }
    return pair_t{left: 20, right: 22}
}

fn main() {
    var ok = make_pair(false) catch e {
        pair_t{left: -1, right: -1}
    }
    println('ok:', ok.left, ok.right)

    var failed = make_pair(true) catch e {
        println('caught:', describe_error(e))
        pair_t{left: 7, right: 9}
    }
    println('fallback:', failed.left, failed.right)
}


fn describe_error(errort e):string {
    if e == test_error_t.PAIR_FAILED { return 'pair failed' }
    return 'operation failed'
}
--- output.txt
ok: 20 22
caught: pair failed
fallback: 7 9

=== test_generic_errable
--- main.x

type test_error_t:errort = enum {
    GENERIC_FAILED,
}

fn echo<value_t>(value_t value, bool fail):value_t! {
    if fail {
        throw test_error_t.GENERIC_FAILED
    }
    return value
}

fn main() {
    var number = echo<int>(42, false) catch e {
        -1
    }
    println('generic value:', number)

    var failed = echo<string>('unused', true) catch e {
        println('generic caught:', describe_error(e))
        'fallback'
    }
    println(failed)
}


fn describe_error(errort e):string {
    if e == test_error_t.GENERIC_FAILED { return 'generic failed' }
    return 'operation failed'
}
--- output.txt
generic value: 42
generic caught: generic failed
fallback

