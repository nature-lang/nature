nature-test/main.x:2:15: vec literal is not supported in .x, use vec<T>.alloc with an allocator

=== test_n_impl_x_interface
--- main.n
import "iface.x"

// an .x interface can only be implemented by .x methods, the mode is part of the fn type.
// this is what keeps allocatable an x mode contract rather than a shared one.
type heap_t:iface.allocatable = int

fn heap_t.alloc(*self, int size):anyptr {
    return 0
}

fn main() {
    heap_t h = 0
    h.alloc(1)
}

--- iface.x
pub type allocatable = interface{
    fn alloc(int size):anyptr
}

--- output.txt
nature-test/main.n:7:2: the fn 'alloc' of type 'main.heap_t' mismatch interface 'nature-test.iface.allocatable'
