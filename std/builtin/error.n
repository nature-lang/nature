// A compiler intrinsic: nominal type identity and a fixed inline payload.
pub type errort = interface {}

pub type errable<value_t, error_t> = union {
    value_t value
    error_t error
}

// Recoverable runtime categories, shared with C utils/type.h.
pub type runtime_error_t:errort = enum:i32 {
    FAILED = 1,
    INVALID_ARGUMENT = 2,
    INDEX_OUT_OF_RANGE = 3,
    TYPE_MISMATCH = 4,
    NULL_POINTER = 5,
    END_OF_FILE = 6,
    TIMEOUT = 7,
    CLOSED = 8,
    CANCELLED = 9,
    KEY_NOT_FOUND = 10,
}

// errno, libuv or platform status. No diagnostic string is allocated.
pub type system_error_t:errort = struct {
    i32 code
}
