// nothing here uses fmt; the import keeps the string methods from strings, which fmt imports,
// available to every module
import fmt

pub type trace_t = struct{
    string path
    string ident
    int line
    int column
}

// `T!` returns errable<T,errset_t>: the value, or an errset.
pub type errable<T,E> = union{
    T value
    E error
}
