type dir_t = anyptr

pub type dirent_t = struct {
    u64 ino
    u64 off
    u16 reclen
    u16 namlen
    u8 t
    [u8;1024] name
}

pub #linkid 'opendir$INODE64'
fn opendir(anyptr str):dir_t

pub #linkid 'readdir$INODE64'
fn readdir(dir_t d):ptr<dirent_t>

pub #linkid closedir
fn closedir(dir_t d):int