// 文件seek的位置
pub int SEEK_SET = 0
pub int SEEK_CUR = 1
pub int SEEK_END = 2

// 标准文件描述符
pub int STDIN = 0
pub int STDOUT = 1
pub int STDERR = 2

pub fn null_device():string {
    return '/dev/null'
}

