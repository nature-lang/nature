// 文件系统相关常量
pub u32 MS_ASYNC = 0x1
u32 MS_INVALIDATE = 0x2
u32 MS_SYNC = 0x10

// 打开文件的标志
pub int O_RDONLY = 0x0000
pub int O_WRONLY = 0x0001
pub int O_RDWR   = 0x0002
pub int O_APPEND = 0x0008
pub int O_CREAT  = 0x0200
pub int O_EXCL   = 0x0800
